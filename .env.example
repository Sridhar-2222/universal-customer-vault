# Copy to .env.local (never commit it). Only PUBLIC values belong in the app:
# Supabase → Project settings → API → Project URL and the anon / publishable key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Address of the bill reading (OCR) service from ocr-service/README.md, e.g. https://YOUR-SPACE.hf.space
EXPO_PUBLIC_OCR_URL=
# Never put the service-role key here or anywhere in the app.
